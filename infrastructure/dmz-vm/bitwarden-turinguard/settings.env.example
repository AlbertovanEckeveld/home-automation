
# ==========================================
# BITWARDEN - TURINGUARD
# ==========================================

# Domain
BW_DOMAIN=bitwarden.turinguard.nl

# Database
BW_DB_PROVIDER=mysql
BW_DB_SERVER=bitwarden-turinguard-db
BW_DB_DATABASE=bitwarden_vault
BW_DB_USERNAME=bitwarden
BW_DB_PASSWORD=CHANGE_ME

# Bitwarden installation credentials
BW_INSTALLATION_ID=CHANGE_ME
BW_INSTALLATION_KEY=CHANGE_ME

# SSL
BW_ENABLE_SSL=true
BW_SSL_CERT=ssl.crt
BW_SSL_KEY=ssl.key

# Disable public registration if desired
globalSettings__disableUserRegistration=true
